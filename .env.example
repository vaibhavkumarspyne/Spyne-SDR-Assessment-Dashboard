# Neon pooled connection string (Neon dashboard > Connect > "Pooled connection").
# For local development against the bundled PGlite server, use:
#   DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
#   DB_POOL_MAX=1   (PGlite accepts a single connection; leave unset on Vercel)
DATABASE_URL=

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Comma-separated @spyne.ai emails that become admins the first time they sign in.
INITIAL_ADMIN_EMAILS=
